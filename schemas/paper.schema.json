{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Constrained Decoding Atlas paper record",
  "type": "object",
  "required": [
    "id", "title", "year", "authors", "venue", "publication_status",
    "study_type", "url", "specification", "representation", "allocation",
    "placement", "rejected_behavior", "guarantees", "systems_measurements",
    "outcome_measurements", "review_status", "evidence_note"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 5},
    "year": {"type": "integer", "minimum": 1950, "maximum": 2100},
    "authors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "venue": {"type": "string"},
    "publication_status": {"enum": ["peer_reviewed", "preprint", "documentation", "other"]},
    "study_type": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "url": {"type": "string", "format": "uri"},
    "code_url": {"type": ["string", "null"]},
    "specification": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "representation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allocation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "placement": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rejected_behavior": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "guarantees": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "systems_measurements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "outcome_measurements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "review_status": {"enum": ["metadata_verified", "full_text_screened", "full_text_coded", "second_pass_verified"]},
    "evidence_note": {"type": "string", "minLength": 10}
  },
  "additionalProperties": false
}
